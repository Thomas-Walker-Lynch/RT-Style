#!/usr/bin/env bash
# -*- mode: sh; sh-basic-offset: 2; indent-tabs-mode: nil -*-

print_help(){ cat <<'HELP'
RT-Style-server_install

Sets up x6 to serve the promoted RT-Style library and runs the server. Run it
as root, after the developer has built and promoted.

Usage: RT-Style-server_install <command>
  help | -h | --help   print this message (also printed when given no arguments)
  preview              show what would be done, including the unit file diff;
                       change nothing
  apply                do it

Steps
  0. Packages and account: installs bindfs and nodejs when missing; creates
     the system account web, with no home and no login shell, when missing.
  1. /etc/fstab: adds the bindfs line for the site directory, unless a line
     for that mount point is already there. The view is read-only, and files
     owned by Thomas_developer appear owned by web. The line carries nofail,
     so a failed mount leaves the server stopped but lets the machine boot.
     An existing line that differs from the wanted one is shown, not changed.
  2. Mount point: creates it when missing; mounts the view when not mounted;
     then confirms it is a bindfs mount and shows the server file in it.
  3. Unit file: shows the diff between the promoted unit and the installed
     one; installs the promoted one, owned by root, when they differ. Removes
     the old drop-in directory if one is left.
  4. systemd: daemon-reload, enable, restart; then fetches setup.html over
     localhost and prints the HTTP status.

A step already in the wanted state is reported and skipped, so rerunning is
safe. Rerun after a promote that changed the unit file or the server code:
step 3 installs a changed unit and step 4 restarts the server.

This script is kept in a directory the code owner can change, and root runs
it. Read it before running it.
HELP
}

set -euo pipefail

CODE_OWNER=Thomas_developer
RUN_AS=web
SITE=style.reasoningtechnology.com
CONSUMER=/home/$CODE_OWNER/project/RT-Style/consumer
MOUNT_POINT=/srv/$SITE
FSTAB_LINE="$CONSUMER  $MOUNT_POINT  fuse.bindfs  ro,nofail,map=$CODE_OWNER/$RUN_AS,chmod-deny,chown-deny,chgrp-deny  0  0"
UNIT=RT-Style-server
UNIT_SOURCE=$CONSUMER/Manuscript/server/$UNIT.service
UNIT_FILE=/etc/systemd/system/$UNIT.service
DROP_IN=/etc/systemd/system/$UNIT.service.d
SERVER_IN_VIEW=$MOUNT_POINT/Manuscript/server/RT-Style-server.js

MODE=""

run(){
  printf '  '; printf '%q ' "$@"; printf '\n'
  if [[ $MODE == apply ]]; then "$@"; fi
}
step(){ printf '\n%s\n' "$*"; }

checks(){
  local problems=()
  [[ $EUID -eq 0 ]] || { echo "Error: run as root." >&2; exit 1; }
  id "$CODE_OWNER" &>/dev/null || problems+=("user $CODE_OWNER does not exist")
  [[ -d $CONSUMER ]]           || problems+=("$CONSUMER not found: build and promote first")
  [[ -f $UNIT_SOURCE ]]        || problems+=("$UNIT_SOURCE not found: build and promote first")
  if (( ${#problems[@]} )); then
    for p in "${problems[@]}"; do echo "Error: $p" >&2; done
    echo "Nothing was changed." >&2
    exit 1
  fi
}

packages_and_account(){
  step "0. packages and account"
  local missing=()
  command -v bindfs >/dev/null || missing+=(bindfs)
  [[ -x /usr/bin/node ]]       || missing+=(nodejs)
  if (( ${#missing[@]} )); then
    run apt-get update
    run apt-get install -y "${missing[@]}"
  else
    echo "  bindfs and nodejs present"
  fi
  if id "$RUN_AS" &>/dev/null; then
    echo "  account $RUN_AS present"
  else
    run adduser --system --group --no-create-home --home /nonexistent "$RUN_AS"
  fi
}

fstab_line(){
  step "1. /etc/fstab"
  local present
  present=$(grep -E "^[^#]*[[:space:]]$MOUNT_POINT[[:space:]]" /etc/fstab || true)
  if [[ -n $present ]]; then
    if [[ $present == "$FSTAB_LINE" ]]; then
      echo "  present"
    else
      echo "  a different line for $MOUNT_POINT is present; edit it by hand if it should change:"
      echo "    present: $present"
      echo "    wanted:  $FSTAB_LINE"
    fi
  else
    echo "  append: $FSTAB_LINE"
    if [[ $MODE == apply ]]; then printf '%s\n' "$FSTAB_LINE" >> /etc/fstab; fi
  fi
}

mount_view(){
  step "2. mount"
  if [[ ! -d $MOUNT_POINT ]]; then
    run install -d -m 755 "$MOUNT_POINT"
  fi
  if mountpoint -q "$MOUNT_POINT"; then
    echo "  mounted"
  else
    # systemd turns fstab lines into .mount units only on a reload.
    run systemctl daemon-reload
    run mount "$MOUNT_POINT"
  fi
  if [[ $MODE == apply ]]; then
    findmnt -n -o FSTYPE,OPTIONS "$MOUNT_POINT" | sed 's/^/  /'
    ls -l "$SERVER_IN_VIEW" | sed 's/^/  /'
  fi
}

unit_file(){
  step "3. unit file"
  if [[ -d $DROP_IN ]]; then
    echo "  old drop-in directory, superseded by the unit file:"
    ls "$DROP_IN" | sed 's/^/    /'
    run rm -r "$DROP_IN"
  fi
  if [[ -f $UNIT_FILE ]] && cmp -s "$UNIT_FILE" "$UNIT_SOURCE"; then
    echo "  installed unit matches the promoted one"
    return
  fi
  echo "  diff installed -> promoted:"
  diff -u "$UNIT_FILE" "$UNIT_SOURCE" 2>/dev/null | sed 's/^/    /' || true
  [[ -f $UNIT_FILE ]] || sed 's/^/    + /' "$UNIT_SOURCE"
  run install -m 644 -o root -g root "$UNIT_SOURCE" "$UNIT_FILE"
}

start(){
  step "4. systemd"
  run systemctl daemon-reload
  run systemctl enable "$UNIT"
  run systemctl restart "$UNIT"
  if [[ $MODE != apply ]]; then
    echo "  would fetch https://$SITE/Manuscript/setup.html from 127.0.0.1"
    return
  fi
  sleep 2
  systemctl --no-pager --lines=5 status "$UNIT" || true
  if command -v curl >/dev/null; then
    printf '  https://%s/Manuscript/setup.html: ' "$SITE"
    curl -sSk --resolve "$SITE:443:127.0.0.1" -o /dev/null -w '%{http_code}\n' \
      "https://$SITE/Manuscript/setup.html" || true
  fi
}

main(){
  if (( $# == 0 )) || [[ $1 == help || $1 == -h || $1 == --help ]]; then print_help; return 0; fi
  if (( $# != 1 )) || [[ $1 != preview && $1 != apply ]]; then
    echo "Error: unknown command '$*'." >&2; echo >&2; print_help; return 1
  fi
  MODE=$1
  checks
  echo "RT-Style-server_install $MODE"
  packages_and_account
  fstab_line
  mount_view
  unit_file
  start
  [[ $MODE == apply ]] || printf '\npreview only: nothing was changed\n'
}

main "$@"
